# Token Discord du bot (à récupérer sur https://discord.com/developers/applications)
DISCORD_TOKEN=

# ID de l'application Discord
CLIENT_ID=

# ID du serveur Discord où le bot fonctionne
GUILD_ID=

# ID de l'utilisateur propriétaire du bot (pour les permissions admin)
BOT_OWNER_ID=

# IDs des modérateurs/staff (séparés par des virgules)
# Exemple: 123456789,987654321,555555555
STAFF_IDS=

# Lien de paiement PayPal personnalisé
PAYPAL_LINK=https://paypal.me/tonpseudo

# ID de la catégorie Discord où créer les tickets (optionnel)
TICKET_CATEGORY_ID=

# ID du salon où envoyer les logs des commandes (optionnel)
LOG_CHANNEL_ID=

# Environnement (development ou production)
NODE_ENV=production
